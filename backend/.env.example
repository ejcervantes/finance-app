# Copia este archivo a .env para desarrollo local fuera de Docker.
# Dentro de Docker, docker-compose ya inyecta estas variables.

DATABASE_URL=postgresql+asyncpg://finance:finance@localhost:5432/finance
JWT_SECRET_KEY=dev-secret-cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Se usa cuando implementemos las features de IA (escaneo y asesor)
GEMINI_API_KEY=
